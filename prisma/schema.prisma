generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PLANNING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VendorStatus {
  LEAD
  APPROVED
  CONTRACTED
  PREFERRED
  INACTIVE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum WorkforceStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum BookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Better Auth core models. Keep these model names and fields aligned with
// Better Auth's Prisma adapter and organization plugin.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  platformRole  String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  memberships       Member[]
  sentInvitations   Invitation[]      @relation("InvitationInviter")
  createdEvents     Event[]           @relation("EventCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  createdTasks      Task[]            @relation("TaskCreator")
  createdExpenses   Expense[]         @relation("ExpenseCreator")
  approvedExpenses  Expense[]         @relation("ExpenseApprover")
  workforceProfiles WorkforceMember[]
  uploadedDocuments Document[]        @relation("DocumentUploader")
  auditLogs         AuditLog[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  activeTeamId         String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth organization plugin models. A user can belong to several
// organizations; all operational records below are organization-scoped.
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members               Member[]
  invitations           Invitation[]
  events                Event[]
  tasks                 Task[]
  vendors               Vendor[]
  vendorEngagements     EventVendor[]
  expenses              Expense[]
  workforceMembers      WorkforceMember[]
  shiftAssignments      ShiftAssignment[]
  sponsors              Sponsor[]
  sponsorships          Sponsorship[]
  venues                Venue[]
  resources             Resource[]
  resourceBookings      ResourceBooking[]
  workshops             Workshop[]
  workshopRegistrations WorkshopRegistration[]
  documents             Document[]
  auditLogs             AuditLog[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  email          String
  inviterId      String
  organizationId String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([inviterId])
  @@map("invitation")
}

// Core Utsav operational data. organizationId is mandatory on every business
// record. Server queries must always scope by the verified tenant context.
model Event {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?
  eventType      String
  status         EventStatus @default(PLANNING)
  startAt        DateTime
  endAt          DateTime?
  timezone       String      @default("Asia/Kolkata")
  venueName      String?
  city           String?
  state          String?
  country        String      @default("India")
  budget         Decimal?    @db.Decimal(14, 2)
  currency       String      @default("INR")
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User              @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks             Task[]
  vendorEngagements EventVendor[]
  expenses          Expense[]
  sponsorships      Sponsorship[]
  shiftAssignments  ShiftAssignment[]
  resourceBookings  ResourceBooking[]
  workshops         Workshop[]
  documents         Document[]

  @@unique([id, organizationId])
  @@index([organizationId, status, startAt])
  @@index([organizationId, name])
  @@map("event")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  assigneeId     String?
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, eventId])
  @@index([assigneeId])
  @@map("task")
}

model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  category       String
  contactName    String?
  email          String?
  phone          String?
  status         VendorStatus @default(LEAD)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       EventVendor[]
  expenses     Expense[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([organizationId, category, status])
  @@map("vendor")
}

model EventVendor {
  id                 String   @id @default(cuid())
  organizationId     String
  eventId            String
  vendorId           String
  serviceDescription String?
  quoteAmount        Decimal? @db.Decimal(14, 2)
  currency           String   @default("INR")
  status             String   @default("PROPOSED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([organizationId, status])
  @@map("event_vendor")
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String?
  vendorId       String?
  description    String
  category       String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR")
  status         ExpenseStatus @default(DRAFT)
  expenseDate    DateTime
  paidAt         DateTime?
  createdById    String
  approvedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional event/vendor links are validated against organizationId in server functions.
  event        Event?       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendor       Vendor?      @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User         @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expenseDate])
  @@index([organizationId, eventId])
  @@map("expense")
}

model WorkforceMember {
  id             String          @id @default(cuid())
  organizationId String
  userId         String?
  displayName    String
  email          String?
  phone          String?
  jobTitle       String?
  department     String?
  status         WorkforceStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments  ShiftAssignment[]

  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@index([organizationId, displayName])
  @@index([organizationId, department, status])
  @@map("workforce_member")
}

model ShiftAssignment {
  id                String   @id @default(cuid())
  organizationId    String
  eventId           String
  workforceMemberId String
  role              String
  startAt           DateTime
  endAt             DateTime
  status            String   @default("SCHEDULED")
  notes             String?
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  workforceMember WorkforceMember @relation(fields: [workforceMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, eventId, startAt])
  @@index([organizationId, workforceMemberId, startAt])
  @@map("shift_assignment")
}

model Sponsor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String?
  contactName    String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partnerships Sponsorship[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("sponsor")
}

model Sponsorship {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  sponsorId      String
  packageName    String?
  amount         Decimal? @db.Decimal(14, 2)
  currency       String   @default("INR")
  status         String   @default("PROPOSED")
  deliverables   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sponsor      Sponsor      @relation(fields: [sponsorId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([eventId, sponsorId])
  @@index([organizationId, status])
  @@map("sponsorship")
}

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String
  state          String?
  country        String   @default("India")
  capacity       Int?
  contactName    String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources    Resource[]

  @@unique([id, organizationId])
  @@index([organizationId, city, name])
  @@map("venue")
}

model Resource {
  id             String   @id @default(cuid())
  organizationId String
  venueId        String?
  name           String
  category       String
  quantity       Int      @default(1)
  status         String   @default("AVAILABLE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional venue links are validated against organizationId in server functions.
  venue        Venue?            @relation(fields: [venueId, organizationId], references: [id, organizationId], onDelete: Restrict)
  bookings     ResourceBooking[]

  @@unique([id, organizationId])
  @@index([organizationId, category, status])
  @@map("resource")
}

model ResourceBooking {
  id             String        @id @default(cuid())
  organizationId String
  resourceId     String
  eventId        String
  quantity       Int           @default(1)
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus @default(TENTATIVE)
  notes          String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource     Resource     @relation(fields: [resourceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  event        Event        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, resourceId, startAt, endAt])
  @@index([organizationId, eventId])
  @@map("resource_booking")
}

model Workshop {
  id             String    @id @default(cuid())
  organizationId String
  eventId        String?
  name           String
  description    String?
  status         String    @default("DRAFT")
  startAt        DateTime
  endAt          DateTime?
  timezone       String    @default("Asia/Kolkata")
  venueName      String?
  city           String?
  capacity       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional event links are validated against organizationId in server functions.
  event         Event?                 @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  registrations WorkshopRegistration[]

  @@unique([id, organizationId])
  @@index([organizationId, status, startAt])
  @@map("workshop")
}

model WorkshopRegistration {
  id             String   @id @default(cuid())
  organizationId String
  workshopId     String
  attendeeName   String
  email          String
  phone          String?
  status         String   @default("REGISTERED")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workshop     Workshop     @relation(fields: [workshopId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([workshopId, email])
  @@index([organizationId, workshopId])
  @@index([email])
  @@map("workshop_registration")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String?
  uploadedById   String
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  storageKey     String   @unique
  category       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Optional event links are validated against organizationId in server functions.
  event        Event?       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, eventId])
  @@map("document")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}
