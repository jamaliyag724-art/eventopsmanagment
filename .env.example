# PostgreSQL connection used by the Vercel Node.js runtime.
# Prefer your provider's pooled/transaction-pool URL (for example Neon pooled URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/utsav?sslmode=require"

# Direct PostgreSQL connection used only by Prisma migrations and Studio.
# If your provider does not expose a separate URL, this can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/utsav?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Local development URL. Set the exact public production URL in Vercel.
BETTER_AUTH_URL="http://localhost:5173"
